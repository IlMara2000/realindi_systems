# Copia questo file in .env e compila i valori.

# --- Database (Prisma / PostgreSQL) ---
DATABASE_URL=postgresql://user:password@localhost:5432/realindi

# Endpoint diretto, usato solo da `db:migrate`, `db:check` e dai comandi Prisma
# in build: il pooler non conserva lo stato di sessione che `migrate` richiede.
# Il runtime dell'applicazione resta su DATABASE_URL (pooled), perché le
# connessioni dirette sono limitate dal piano. Se vuota, si usa DATABASE_URL.
DIRECT_URL=

# Database della suite di test (npm test): i test girano qui, applicano le
# migrazioni e svuotano le tabelle a ogni run. Il database non viene creato né
# distrutto, deve esistere già (può essere vuoto, senza tabelle: basta
# `createdb realindi_test`).
#
# La suite elimina da sola i database `realindi_test_run_<timestamp>_<nonce>`
# rimasti dalle vecchie run: quelli più vecchi di un'ora all'avvio, quelli nati
# durante l'esecuzione alla fine. Senza questa pulizia si accumulavano fino a
# far rifiutare ogni connessione all'account Prisma con `planLimitReached`.
#
# La variabile può anche essere esportata nell'ambiente (è il caso della CI):
# se presente lì, ha la precedenza sul file .env.
DATABASE_URL_TEST=postgresql://user:password@localhost:5432/realindi_test

# --- Integrazioni (opzionali) ---
# Senza queste variabili le integrazioni restano disattivate e il sito
# funziona comunque (viste Note/Calendario incluse, solo sync/email spenti).

# Chiave simmetrica per cifrare (AES-256-GCM) le credenziali Google/Apple
# salvate nel database. Usane una lunga e casuale (es. `openssl rand -hex 32`)
# e NON cambiarla mai dopo aver collegato un account: la perdita rende
# necessario ricollegare Google e Apple.
INTEGRATIONS_KEY=

# OAuth client Google Cloud (tipo "Web application") con tra i redirect URI
# autorizzati: https://<dominio>/api/integrations/google/callback
# Servono le API Google Calendar e Gmail attivate sul progetto.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Origine pubblica usata per il redirect OAuth, senza percorso e senza barra
# finale (es. https://realindi-systems.vercel.app). Su Vercel l'host cambia fra
# produzione, dominio personalizzato e preview: senza questa variabile il
# redirect_uri seguirebbe l'host e Google risponderebbe redirect_uri_mismatch.
# In locale si può lasciare vuota.
APP_ORIGIN=

# Metti 1 per chiedere anche la lettura dell'inbox Gmail (gmail.readonly).
# È uno scope ristretto: su un'app non verificata Google blocca il consenso,
# quindi resta spento di default. Il calendario funziona senza.
GOOGLE_GMAIL_INBOX=

# --- Canali di messaggistica e assistente AI (opzionali) ---
# WhatsApp, Instagram e SMS si configurano da «Canali» nell'app: le
# credenziali vengono cifrate nel database e non servono variabili dedicate.
# Chiave della Developer API di Freebuff: creala da Account → Developer API
# (https://freebuff.com/account/api). Puoi incollarla anche dall'interfaccia:
# quella salvata nel database ha la precedenza su questa.
# Default: Developer API di Freebuff (OpenAI-compatibile, elenco modelli su
# https://freebuff.com/api/v1/paid/models). AI_BASE_URL e AI_MODEL, se
# impostate, hanno la precedenza sui valori salvati dall'interfaccia.
AI_API_KEY=
AI_BASE_URL=https://freebuff.com/api/v1/paid
AI_MODEL=deepseek-v4.1-flash
# Versione Graph API di Meta usata per WhatsApp e Instagram (default v23.0).
META_GRAPH_VERSION=v23.0

# --- Buffy, assistente operativo del proprietario (opzionali) ---
# Usa una chiave separata da quella dell'assistente clienti se vuoi tenere
# distinto il budget. Se vuota, Buffy riusa AI_API_KEY (o la chiave salvata
# dall'interfaccia). AGENT_BASE_URL e AGENT_MODEL permettono di cambiare
# provider/modello senza toccare la configurazione dei canali.
AGENT_API_KEY=
AGENT_BASE_URL=
AGENT_MODEL=

# --- Passkey (Face ID / impronta) ---
# Dominio su cui sono registrate le passkey: https://realindi.vercel.app in
# produzione, http://localhost:8080 in sviluppo. Non si legge dall'header Host,
# che chi chiama può scrivere. Cambiandolo le passkey vanno registrate di nuovo.
APP_ORIGIN=
