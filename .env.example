# Copia questo file in .env e compila i valori.

# --- Database (Prisma / PostgreSQL) ---
DATABASE_URL=postgresql://user:password@localhost:5432/realindi

# Endpoint diretto, usato solo da `db:migrate`, `db:check` e dai comandi Prisma
# in build: il pooler non conserva lo stato di sessione che `migrate` richiede.
# Il runtime dell'applicazione resta su DATABASE_URL (pooled), perché le
# connessioni dirette sono limitate dal piano. Se vuota, si usa DATABASE_URL.
DIRECT_URL=

# Connessione MODELLO per la suite di test (npm test). I test non girano su
# questo database: host, credenziali e sslmode vengono copiati, mentre il nome
# serve solo come punto di partenza. Ogni esecuzione crea accanto a questo un
# database proprio (realindi_test_run_<timestamp>_<nonce>), vi applica le
# migrazioni e lo elimina alla fine; quelli rimasti da una run interrotta
# vengono cancellati al successivo avvio dopo un'ora.
#
# Servono due cose:
#  - che il database indicato qui ESISTA (può essere vuoto, senza tabelle:
#    basta `createdb realindi_test`);
#  - che il ruolo Postgres abbia il privilegio CREATEDB, perché la suite crea
#    e distrugge database. Senza di esso il primo test si ferma con
#    "permission denied to create database".
#
# La variabile può anche essere esportata nell'ambiente (è il caso della CI):
# se presente lì, ha la precedenza sul file .env.
DATABASE_URL_TEST=postgresql://user:password@localhost:5432/realindi_test

# --- Integrazioni (opzionali) ---
# Senza queste variabili le integrazioni restano disattivate e il sito
# funziona comunque (viste Note/Calendario incluse, solo sync/email spenti).

# Chiave simmetrica per cifrare (AES-256-GCM) le credenziali Google/Apple
# salvate nel database. Usane una lunga e casuale (es. `openssl rand -hex 32`)
# e NON cambiarla mai dopo aver collegato un account: la perdita rende
# necessario ricollegare Google e Apple.
INTEGRATIONS_KEY=

# OAuth client Google Cloud (tipo "Web application") con tra i redirect URI
# autorizzati: https://<dominio>/api/integrations/google/callback
# Servono le API Google Calendar e Gmail attivate sul progetto.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Canali di messaggistica e assistente AI (opzionali) ---
# WhatsApp, Instagram e SMS si configurano da «Canali & AI» nell'app: le
# credenziali vengono cifrate nel database e non servono variabili dedicate.
# Questa chiave API è solo un fallback: puoi incollarla anche dall'interfaccia.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Versione Graph API di Meta usata per WhatsApp e Instagram (default v23.0).
META_GRAPH_VERSION=v23.0
