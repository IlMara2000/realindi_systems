// REALINDI CRM — schema Prisma fedele al database SQLite originale.
// I nomi dei campi restano snake_case: /api/state deve restare identico al vecchio backend.
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Default per created_at: stesso formato UTC di SQLite (CURRENT_TIMESTAMP).
// created_at default: to_char(now() AT TIME ZONE 'utc', 'YYYY-MM-DD HH24:MI:SS')

model Setting {
  key   String @id
  value String
  @@map("settings")
}

model Session {
  token   String @id
  expires Float
  @@map("sessions")
}

model Client {
  id             Int     @id @default(autoincrement())
  name           String
  email          String
  company        String
  phone          String
  vat_number     String
  address        String
  notes          String
  created_at     String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  country        String  @default("")
  city           String  @default("")
  postcode       String  @default("")
  province       String  @default("")
  tax_country    String  @default("")
  tax_code       String  @default("")
  recipient_code String  @default("")
  pec            String  @default("")
  buyer_type     String  @default("")
  projects       Project[]
  documents      Document[]
  @@map("clients")
}

model Project {
  id          Int       @id @default(autoincrement())
  client_id   Int
  title       String
  description String
  status      String
  deadline    String
  created_at  String    @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  client      Client    @relation(fields: [client_id], references: [id])
  quotes      Quote[]
  invoices    Invoice[]
  documents   Document[]
  @@map("projects")
}

model Quote {
  id             Int      @id @default(autoincrement())
  project_id     Int
  title          String
  items          String
  subtotal       Int
  vat            Int
  total          Int
  vat_rate       String
  status         String   @default("draft")
  valid_until    String
  notes          String
  created_at     String   @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  estimate       String?
  generation_key String?  @unique
  project        Project  @relation(fields: [project_id], references: [id])
  invoice        Invoice?
  @@map("quotes")
}

model Invoice {
  id           Int      @id @default(autoincrement())
  quote_id     Int?     @unique
  project_id   Int
  number       String?  @unique
  snapshot     String
  subtotal     Int
  vat          Int
  total        Int
  status       String   @default("draft")
  due_date     String
  issued_at    String?
  paid_at      String?
  created_at   String   @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  xml          Bytes?
  xml_filename String?
  quote        Quote?   @relation(fields: [quote_id], references: [id])
  project      Project  @relation(fields: [project_id], references: [id])
  @@map("invoices")
}

model Document {
  id           Int      @id @default(autoincrement())
  client_id    Int
  project_id   Int?
  name         String
  storage_name String   @unique
  size         Int
  sha256       String
  created_at   String   @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  // I contenuti dei file vivevano su disco (data/documents): ora nel database.
  content      Bytes
  client       Client   @relation(fields: [client_id], references: [id])
  project      Project? @relation(fields: [project_id], references: [id])
  @@map("documents")
}

model Appointment {
  id           Int      @id @default(autoincrement())
  name         String
  email        String
  notes        String
  start        String
  end          String
  status       String   @default("confirmed")
  cancel_token String   @unique
  created_at   String   @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  @@map("appointments")
}

model Block {
  id     Int    @id @default(autoincrement())
  start  String
  end    String
  reason String
  @@map("blocks")
}

model LoginAttempt {
  ip    String @id
  count Int
  reset Float
  @@map("login_attempts")
}

// Sezioni nuove: Note e Calendario/Planner (spec 2026-11-03).
model Note {
  id         Int     @id @default(autoincrement())
  title      String
  body       String  @default("")
  pinned     Boolean @default(false)
  client_id  Int?
  project_id Int?
  created_at String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  updated_at String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  @@map("notes")
}

model CalendarEvent {
  id            Int     @id @default(autoincrement())
  title         String
  start         String
  end           String
  all_day       Boolean @default(false)
  description   String?
  location      String?
  updated_at    BigInt
  dirty         Boolean @default(true)
  deleted_at    String?
  appointment_id Int?
  @@map("calendar_events")
}

// Un evento può vivere su più provider: ogni riga è il legame con uno di essi.
model EventLink {
  id          Int     @id @default(autoincrement())
  event_id    Int
  source      String
  external_id String
  etag        String?
  dirty       Boolean @default(true)
  deleted_at  String?
  @@unique([source, external_id])
  @@map("event_links")
}

// Stato di sincronizzazione per provider (syncToken Google, path CalDAV).
model SyncState {
  provider      String  @id
  token         String?
  calendar_path String?
  last_sync_at  String?
  @@map("sync_state")
}

// ------------------------------------------------------------------ canali
// Un canale è un collegamento a un provider di messaggistica (WhatsApp Cloud
// API, Instagram Messaging, Twilio SMS). Le credenziali vivono cifrate in
// `credentials` (AES-256-GCM con INTEGRATIONS_KEY) e non escono mai dal server.
model Channel {
  id          Int            @id @default(autoincrement())
  provider    String
  label       String         @default("")
  external_id String
  detail      String         @default("")
  status      String         @default("connected")
  last_error  String         @default("")
  auto_reply  Boolean        @default(true)
  credentials String
  created_at  String         @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  updated_at  String         @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  conversations Conversation[]
  @@index([provider, external_id])
  @@map("channels")
}

// Una conversazione per contatto e canale; unisce i messaggi in ingresso e in
// uscita (assistente o titolare).
model Conversation {
  id              Int       @id @default(autoincrement())
  channel_id      Int
  contact         String
  contact_name    String    @default("")
  status          String    @default("open")
  unread          Int       @default(0)
  auto_reply      Boolean   @default(true)
  last_message_at String
  created_at      String    @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  channel         Channel   @relation(fields: [channel_id], references: [id])
  messages        Message[]
  @@unique([channel_id, contact])
  @@map("conversations")
}

model Message {
  id              Int          @id @default(autoincrement())
  conversation_id Int
  direction       String
  author          String
  body            String
  external_id     String?
  status          String       @default("sent")
  error           String       @default("")
  created_at      String       @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  conversation    Conversation @relation(fields: [conversation_id], references: [id])
  @@unique([conversation_id, external_id])
  @@index([conversation_id, id])
  @@map("messages")
}

// Conoscenza dell'assistente: pagine del sito pubblico raccolte dal CRM più
// una scheda manuale costruita dalle impostazioni dell'attività.
model KnowledgeDoc {
  id         Int    @id @default(autoincrement())
  url        String @unique
  title      String @default("")
  content    String
  hash       String
  updated_at String @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  @@map("knowledge_docs")
}

// --------------------------------------------------------------- ricevute
// Registro delle quietanze di cassa: il numero è progressivo per anno e unico,
// assegnato dal server dentro una transazione (mai dal browser).
model Receipt {
  id           Int    @id @default(autoincrement())
  year         Int
  number       Int
  issued_on    String
  place        String @default("")
  payer        String
  tax_code     String @default("")
  amount_cents Int
  amount_words String
  reason       String
  issuer       String @default("")
  created_at   String @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  @@unique([year, number])
  @@index([issued_on])
  @@map("receipts")
}
