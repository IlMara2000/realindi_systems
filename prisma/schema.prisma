// REALINDI CRM — schema Prisma fedele al database SQLite originale.
// I nomi dei campi restano snake_case: /api/state deve restare identico al vecchio backend.
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Default per created_at: stesso formato UTC di SQLite (CURRENT_TIMESTAMP).
// created_at default: to_char(now() AT TIME ZONE 'utc', 'YYYY-MM-DD HH24:MI:SS')

model Setting {
  key   String @id
  value String
  @@map("settings")
}

// Sessione aperta. Il token nel cookie non è mai salvato: resta l'hash. Le
// colonne di contesto servono al pannello Sicurezza — da dove è nata la sessione
// e quando è stata usata l'ultima volta — e a poterla chiudere una per una.
model Session {
  token      String @id
  expires    Float
  ip         String @default("")
  user_agent String @default("")
  created_at Float  @default(0)
  last_seen  Float  @default(0)
  @@map("sessions")
}

// Passkey (WebAuthn): accesso con Face ID, impronta o PIN del dispositivo.
// Il segreto non lascia il dispositivo; qui resta la chiave pubblica con cui
// verificare la firma. `counter` deve crescere a ogni accesso: un valore che
// torna indietro è il segnale di un autenticatore clonato.
model Passkey {
  id         String @id
  public_key Bytes
  counter    BigInt @default(0)
  transports String @default("")
  label      String @default("")
  created_at BigInt @default(0)
  last_used  BigInt @default(0)
  @@map("passkeys")
}

// Sfida WebAuthn in sospeso: monouso e con scadenza breve. Su Vercel ogni
// richiesta può cadere su un'istanza diversa, quindi non può stare in memoria.
model PasskeyChallenge {
  id        String @id
  challenge String
  kind      String
  ip        String @default("")
  expires   Float
  @@map("passkey_challenges")
}

model Client {
  id             Int     @id @default(autoincrement())
  name           String
  email          String
  company        String
  phone          String
  vat_number     String
  address        String
  notes          String
  created_at     String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  country        String  @default("")
  city           String  @default("")
  postcode       String  @default("")
  province       String  @default("")
  tax_country    String  @default("")
  tax_code       String  @default("")
  recipient_code String  @default("")
  pec            String  @default("")
  buyer_type     String  @default("")
  projects       Project[]
  documents      Document[]
  @@map("clients")
}

model Project {
  id          Int       @id @default(autoincrement())
  client_id   Int
  title       String
  description String
  status      String
  deadline    String
  created_at  String    @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  client      Client    @relation(fields: [client_id], references: [id])
  quotes      Quote[]
  invoices    Invoice[]
  documents   Document[]
  @@map("projects")
}

model Quote {
  id             Int      @id @default(autoincrement())
  project_id     Int
  title          String
  items          String
  subtotal       Int
  vat            Int
  total          Int
  vat_rate       String
  status         String   @default("draft")
  valid_until    String
  notes          String
  created_at     String   @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  estimate       String?
  generation_key String?  @unique
  project        Project  @relation(fields: [project_id], references: [id])
  invoice        Invoice?
  @@map("quotes")
}

model Invoice {
  id           Int      @id @default(autoincrement())
  quote_id     Int?     @unique
  project_id   Int
  number       String?  @unique
  snapshot     String
  subtotal     Int
  vat          Int
  total        Int
  status       String   @default("draft")
  due_date     String
  issued_at    String?
  paid_at      String?
  created_at   String   @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  xml          Bytes?
  xml_filename String?
  // Invio allo SdI (canale PEC): lo stato vive qui, l'XML resta immutabile.
  sdi_state      String  @default("not_sent")
  sdi_sent_at    String?
  sdi_updated_at String?
  // Istante dell'evento che ha prodotto lo stato: la data della notifica SdI
  // oppure l'istante dell'invio. Serve a non applicare notifiche più vecchie.
  sdi_event_at   String?
  sdi_message    String  @default("")
  quote        Quote?   @relation(fields: [quote_id], references: [id])
  project      Project  @relation(fields: [project_id], references: [id])
  @@map("invoices")
}

// Ultima lettura delle ricevute SdI: una riga sola (id 1), riscritta a ogni
// lettura, riuscita o no. Il pannello Impostazioni → Invio allo SdI la mostra
// per far vedere che il cron gira davvero e quanto ha applicato. Non finisce
// nel backup: è stato dell'istanza, non un dato del CRM.
model SdiSync {
  id       Int     @id
  last_at  String
  updated  Int     @default(0)
  ignorate Int     @default(0)
  superate Int     @default(0)
  ok       Boolean @default(true)
  error    String  @default("")

  @@map("sdi_sync")
}

// Notifiche SdI già conteggiate: la casella viene riletta intera ogni 30
// minuti, quindi senza questa memoria «senza fattura» e «più vecchie di quelle
// registrate» si ripeterebbero identici a ogni giro. `chiave` è l'impronta del
// file di notifica, `vista_il` serve a potare le righe quando il messaggio esce
// dalla finestra di lettura. Non finisce nel backup: stato dell'istanza.
model SdiNotifica {
  chiave   String @id
  vista_il String

  @@index([vista_il])
  @@map("sdi_notifiche")
}

model Document {
  id           Int      @id @default(autoincrement())
  client_id    Int
  project_id   Int?
  name         String
  storage_name String   @unique
  size         Int
  sha256       String
  created_at   String   @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  // I contenuti dei file vivevano su disco (data/documents): ora nel database.
  content      Bytes
  client       Client   @relation(fields: [client_id], references: [id])
  project      Project? @relation(fields: [project_id], references: [id])
  @@map("documents")
}

model Appointment {
  id           Int      @id @default(autoincrement())
  name         String
  email        String
  notes        String
  start        String
  end          String
  status       String   @default("confirmed")
  cancel_token String   @unique
  created_at   String   @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  @@map("appointments")
}

model Block {
  id     Int    @id @default(autoincrement())
  start  String
  end    String
  reason String
  @@map("blocks")
}

model LoginAttempt {
  ip    String @id
  count Int
  reset Float
  @@map("login_attempts")
}

// Accessi riusciti: chi è entrato, quando, da quale IP e con quale credenziale.
// Alimenta il pannello Sicurezza, che segnala gli indirizzi mai visti prima.
// `at` è in millisecondi UTC come assistant_hits. Non finisce nel backup: è
// storia dell'istanza, non un dato del CRM.
model LoginEvent {
  id  Int    @id @default(autoincrement())
  at  Float
  ip  String
  via String
  @@index([at])
  @@map("login_events")
}

// Sezioni nuove: Note e Calendario/Planner (spec 2026-11-03).
model Note {
  id         Int     @id @default(autoincrement())
  title      String
  body       String  @default("")
  pinned     Boolean @default(false)
  client_id  Int?
  project_id Int?
  created_at String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  updated_at String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  @@map("notes")
}

model CalendarEvent {
  id            Int     @id @default(autoincrement())
  title         String
  start         String
  end           String
  all_day       Boolean @default(false)
  description   String?
  location      String?
  updated_at    BigInt
  dirty         Boolean @default(true)
  deleted_at    String?
  appointment_id Int?
  @@map("calendar_events")
}

// Un evento può vivere su più provider: ogni riga è il legame con uno di essi.
// `calendar_id` fa parte dell'identità: gli id evento di Google sono univoci
// solo dentro un calendario, quindi due calendari possono ripetere lo stesso id.
model EventLink {
  id          Int     @id @default(autoincrement())
  event_id    Int
  source      String
  calendar_id String  @default("primary")
  external_id String
  etag        String?
  dirty       Boolean @default(true)
  deleted_at  String?
  @@unique([source, calendar_id, external_id])
  @@map("event_links")
}

// Stato di sincronizzazione per provider (path CalDAV iCloud).
model SyncState {
  provider      String  @id
  token         String?
  calendar_path String?
  last_sync_at  String?
  @@map("sync_state")
}

// Conflitto fra la versione locale e quella remota di un evento: si conservano
// entrambe, così nessuna delle due va persa quando la scelta è ambigua o
// rimandata. `resolution` vale pending finché qualcuno non decide.
model SyncConflict {
  id          Int     @id @default(autoincrement())
  link_id     Int
  source      String
  entity_kind String  @default("event")
  entity_id   Int
  local_json  String
  remote_json String
  detected_at String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  resolution  String  @default("pending")
  resolved_at String?
  resolved_by String  @default("")
  @@index([resolution, detected_at])
  @@index([link_id])
  @@map("sync_conflicts")
}

// Rubrica locale: contatti importati da iCloud (CardDAV) e Google (People API).
// Un contatto può arrivare da più provider: le identità remote stanno nei
// contact_links, mentre la deduplica unisce per email e poi per telefono, così
// la stessa persona non compare due volte. `client_id` è il legame al cliente
// del CRM, assegnato solo quando email o telefono coincidono.
model Contact {
  id           Int           @id @default(autoincrement())
  client_id    Int?
  display_name String        @default("")
  given_name   String        @default("")
  family_name  String        @default("")
  org          String        @default("")
  job_title    String        @default("")
  emails       String        @default("[]")
  phones       String        @default("[]")
  notes        String        @default("")
  updated_at   BigInt
  deleted_at   String?
  created_at   String        @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  @@index([deleted_at])
  @@index([display_name])
  @@index([client_id])
  @@map("contacts")
}

// Identità del contatto su un provider: href della .vcf (CardDAV) o
// resourceName "people/…" (People API), con l'ETag per gli aggiornamenti.
model ContactLink {
  id          Int     @id @default(autoincrement())
  contact_id  Int
  source      String // "icloud" | "google"
  addressbook String  @default("")
  remote_id   String
  etag        String?
  deleted_at  String?
  @@unique([source, remote_id])
  @@index([contact_id])
  @@map("contact_links")
}

// Stato per rubrica remota: ctag su CardDAV, syncToken su People API.
model SyncAddressbook {
  provider     String
  addressbook  String
  name         String  @default("")
  ctag         String?
  sync_token   String?
  last_sync_at String?
  @@id([provider, addressbook])
  @@map("sync_addressbooks")
}

// Canale di notifica Google (events.watch): uno per calendario. Google chiama
// l'URL con un POST vuoto; il canale dice quale calendario è cambiato. I canali
// scadono (al massimo pochi giorni) e vengono rinnovati prima della scadenza.
model SyncChannel {
  channel_id  String @id
  provider    String
  calendar_id String
  resource_id String @default("")
  address     String
  token       String @default("")
  expiration  BigInt
  created_at  String @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  @@index([provider, calendar_id])
  @@index([expiration])
  @@map("sync_channels")
}

// Un calendario remoto sincronizzato. Google emette un syncToken PER
// calendario: lo stato vive qui, non più in sync_state.token.
model SyncCalendar {
  provider     String  // "google"
  calendar_id  String  // id Google, oppure href per le collezioni CalDAV
  name         String  @default("")
  access_role  String  @default("")
  primary      Boolean @default(false)
  token        String?
  last_sync_at String?
  @@id([provider, calendar_id])
  @@map("sync_calendars")
}

// ------------------------------------------------------------------ canali
// Un canale è un collegamento a un provider di messaggistica (WhatsApp Cloud
// API, Instagram Messaging, Twilio SMS). Le credenziali vivono cifrate in
// `credentials` (AES-256-GCM con INTEGRATIONS_KEY) e non escono mai dal server.
model Channel {
  id          Int            @id @default(autoincrement())
  provider    String
  label       String         @default("")
  external_id String
  detail      String         @default("")
  status      String         @default("connected")
  last_error  String         @default("")
  auto_reply  Boolean        @default(true)
  credentials String
  created_at  String         @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  updated_at  String         @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  conversations Conversation[]
  @@index([provider, external_id])
  @@map("channels")
}

// Una conversazione per contatto e canale; unisce i messaggi in ingresso e in
// uscita (assistente o titolare).
model Conversation {
  id              Int       @id @default(autoincrement())
  channel_id      Int
  contact         String
  contact_name    String    @default("")
  status          String    @default("open")
  unread          Int       @default(0)
  auto_reply      Boolean   @default(true)
  last_message_at String
  created_at      String    @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  channel         Channel   @relation(fields: [channel_id], references: [id])
  messages        Message[]
  attachments     MessageAttachment[]
  @@unique([channel_id, contact])
  @@map("conversations")
}

model Message {
  id              Int          @id @default(autoincrement())
  conversation_id Int
  direction       String
  author          String
  body            String
  external_id     String?
  status          String       @default("sent")
  error           String       @default("")
  created_at      String       @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  // Media allegati (foto, PDF, audio): tipo e riferimento al file salvato.
  media_type         String?
  media_storage_name String?
  media_url          String?
  conversation       Conversation           @relation(fields: [conversation_id], references: [id])
  attachments        MessageAttachment[]
  @@unique([conversation_id, external_id])
  @@index([conversation_id, id])
  @@map("messages")
}

// Conoscenza dell'assistente: pagine del sito pubblico raccolte dal CRM più
// una scheda manuale costruita dalle impostazioni dell'attività.
model KnowledgeDoc {
  id         Int    @id @default(autoincrement())
  url        String @unique
  title      String @default("")
  content    String
  hash       String
  updated_at String @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  @@map("knowledge_docs")
}

// --------------------------------------------------------------- ricevute
// Registro delle quietanze di cassa: il numero è progressivo per anno e unico,
// assegnato dal server dentro una transazione (mai dal browser).
model Receipt {
  id           Int    @id @default(autoincrement())
  year         Int
  number       Int
  issued_on    String
  place        String @default("")
  payer        String
  tax_code     String @default("")
  amount_cents Int
  amount_words String
  reason       String
  issuer       String @default("")
  // Annullamento logico: la ricevuta resta nel registro e il numero non si
  // riusa mai, altrimenti due documenti diversi avrebbero lo stesso numero.
  cancelled_at String?
  cancel_reason String?
  created_at   String @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  @@unique([year, number])
  @@index([issued_on])
  @@map("receipts")
}

// ------------------------------------------------- assistente: limite di frequenza
// Tentativi di generazione dell'assistente, uno per risposta richiesta. Lo stato
// sta qui e non in memoria perché su Vercel ogni istanza ha la sua: i conteggi
// devono valere per tutte. `at` è in millisecondi UTC.
model AssistantHit {
  id  Int    @id @default(autoincrement())
  key String
  at  BigInt

  @@index([key, at])
  @@index([at])
  @@map("assistant_hits")
}

// --------------------------------------------------------------- strumenti
// Link brevi: `/l/<slug>` è pubblico e reindirizza al bersaglio, contando i
// clic. Il bersaglio può essere un indirizzo http(s) o un percorso interno.
model ShortLink {
  id         Int     @id @default(autoincrement())
  slug       String  @unique
  target     String
  label      String  @default("")
  clicks     Int     @default(0)
  // Visite uniche: una per impronta (IP + browser) al giorno. `clicks` resta
  // il conteggio grezzo, così si vede anche quanto pesano refresh e bot.
  unique_visits Int  @default(0)
  active     Boolean @default(true)
  created_at String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  qr_codes   QrCode[]
  visits     LinkVisit[]
  @@index([created_at])
  @@map("short_links")
}

// Eventi di visita: servono al conteggio delle visite uniche e si eliminano da
// soli dopo 35 giorni. `fingerprint` è un hash salato di giorno, link, IP e
// browser: non conserva l'indirizzo in chiaro.
model LinkVisit {
  id          Int    @id @default(autoincrement())
  link_id     Int
  fingerprint String
  at          BigInt
  link        ShortLink @relation(fields: [link_id], references: [id], onDelete: Cascade)
  @@unique([link_id, fingerprint])
  @@index([link_id, at])
  @@map("link_visits")
}

// QR personalizzati: il contenuto è testo libero (un link, un contatto, una
// nota) e la foto del centro vive nel database come BLOB, come i documenti.
// Il codice non è salvato come immagine: si ridisegna dal contenuto, così
// colori e foto restano modificabili senza perdere qualità.
model QrCode {
  id         Int     @id @default(autoincrement())
  title      String
  payload    String
  foreground String  @default("#111111")
  background String  @default("#ffffff")
  ecc        String  @default("H")
  // QR dinamico: se c'è un link breve, il codice contiene il suo indirizzo e la
  // destinazione si cambia senza ristampare. Senza link vale `payload`.
  link_id    Int?
  link       ShortLink? @relation(fields: [link_id], references: [id], onDelete: SetNull)
  logo_mime  String?
  logo       Bytes?
  created_at String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  @@index([created_at])
  @@index([link_id])
  @@map("qr_codes")
}

// Allegati ai messaggi di conversazione (foto, PDF, audio, documenti).
// I contenuti vivono nel database come BLOB, come i documenti esistenti.
model MessageAttachment {
  id              Int      @id @default(autoincrement())
  message_id      Int
  conversation_id Int
  filename        String
  mime_type       String
  size            Int
  sha256          String
  storage_name    String   @unique
  content         Bytes
  created_at      String   @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'), 'YYYY-MM-DD HH24:MI:SS')"))
  message         Message  @relation(fields: [message_id], references: [id], onDelete: Cascade)
  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  @@index([conversation_id])
  @@map("message_attachments")
}
